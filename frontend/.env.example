# Monsoon Sentinel Frontend - Environment Configuration Example
# Copy this file to .env.local for local testing or set in your hosting provider (Vercel / Netlify / Amplify)

# Production API Gateway URL:
# Replace with your deployed AWS API Gateway stage URL (e.g. from sam deploy output or CloudFormation)
# Format: https://{api-id}.execute-api.ap-south-1.amazonaws.com/Prod
VITE_API_BASE_URL=https://your-api-gateway-id.execute-api.ap-south-1.amazonaws.com/Prod
